# Copy to .env (git-ignored). Never commit real values.

# Owner connection, used only by setup and onboarding scripts.
DATABASE_ADMIN_URL=postgres://postgres:CHANGE_ME@localhost:5432/ecosure
# Runtime connection as the least-privilege role created by schema.sql.
DATABASE_URL=postgres://ecosure_app:CHANGE_ME@localhost:5432/ecosure
ECOSURE_APP_DB_PASSWORD=CHANGE_ME

# 32+ random bytes each, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IDENTIFIER_HMAC_KEY=
HANDOVER_HMAC_KEY=

PORT=4000
NODE_ENV=development
# Origin of the web client in development (Vite).
WEB_ORIGIN=http://localhost:5173

# Password for pilot onboarding accounts created by `npm run onboard:pilot`.
PILOT_ACCOUNT_PASSWORD=
