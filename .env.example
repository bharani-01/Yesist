# Copy to .env (git-ignored). Never commit real values.

# Owner connection, used only by setup and onboarding scripts.
DATABASE_ADMIN_URL=postgres://postgres:CHANGE_ME@localhost:5432/ecosure
# Runtime connection as the least-privilege role created by schema.sql.
DATABASE_URL=postgres://ecosure_app:CHANGE_ME@localhost:5432/ecosure
ECOSURE_APP_DB_PASSWORD=CHANGE_ME

# 32+ random bytes each, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IDENTIFIER_HMAC_KEY=
HANDOVER_HMAC_KEY=

# Hosted PostgreSQL whose certificates chain to a private root (Supabase): path to that root CA.
# TLS is then required and verified; leave unset for a local server.
# DATABASE_CA_CERT_FILE=database/certs/supabase-root-ca.crt

PORT=4000
NODE_ENV=development
# Allowed web origins, comma-separated (Vite in development; both Firebase Hosting domains in production).
WEB_ORIGIN=http://localhost:5173
# Proxy hops to trust for client IPs: false, true (one hop), or a number.
TRUST_PROXY=false
# Firebase Hosting forwards only a cookie named __session to Cloud Run.
SESSION_COOKIE_NAME=ecosure_session
# HTTPS-only session cookie. Always on in production; set true for a hosted development stage.
COOKIE_SECURE=false

# Password for pilot onboarding accounts created by `npm run onboard:pilot`.
PILOT_ACCOUNT_PASSWORD=

# Local demos and the hosted development stage only: lists the onboarding test accounts on the sign-in page and lets
# the client fill in their shared password. The API refuses to start with this in production.
DEMO_LOGIN_ENABLED=false

# WAHA & AI
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
WAHA_API_URL=https://waha.ecosure.trackifyapp.co.in
WAHA_SESSION_NAME=Bharani
WAHA_API_KEY=waha_secret_key_2026
WHATSAPP_TEST_MODE=true
WHATSAPP_TEST_NUMBERS=919876543210

